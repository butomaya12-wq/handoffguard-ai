# Cloud-only packaging: React and FastAPI on one HTTPS origin behind Render TLS.
# The existing local Compose Dockerfiles and named SQLite volume are unchanged.
FROM node:22-alpine AS frontend-build

WORKDIR /web
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/ ./
RUN npm run build

FROM python:3.12-slim AS runtime
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app
COPY backend/pyproject.toml ./pyproject.toml
COPY backend/app ./app
RUN pip install --no-cache-dir '.[cloud]' \
    && groupadd --system handoffguard \
    && useradd --system --gid handoffguard handoffguard

COPY --from=frontend-build /web/dist /app/static
USER handoffguard

EXPOSE 10000
# Cloud entrypoint checks PostgreSQL and secure demo environment at startup.
CMD ["sh", "-c", "exec uvicorn app.cloud:create_cloud_app --factory --host 0.0.0.0 --port \"${PORT:-10000}\""]
